  "description": "Unified MCP server for the OBaaSS stack — vault access, backup history, and plugin integration",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
