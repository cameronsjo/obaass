# Required: path to the Obsidian vault on disk
VAULT_PATH=/vault

# MCP server settings
MCP_HTTP_PORT=3000
# Default 127.0.0.1 (loopback IP literals only). Any other bind needs
# MCP_AUTH_TOKEN or MCP_AUTH_TOKEN_LIMITED, or the server refuses to start. The
# container image sets 0.0.0.0 so its published port works; do not set
# 127.0.0.1 for a container.
# MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PATH=/mcp
LOG_LEVEL=info

# Bearer token for the `full` tier: every tool, and the only token that gets
# detailed /health. Required (or the limited token) when MCP_HTTP_HOST is not
# loopback. At least 32 characters from a random source: `openssl rand -hex 32`.
# Clients send `Authorization: Bearer <token>`. Keep it out of git.
# MCP_AUTH_TOKEN=

# Bearer token for the `limited` tier: read and literal search, create new notes,
# append. No delete, rename, frontmatter, backup, or plugin tools; no dot paths;
# writes only to .md files. Must differ from MCP_AUTH_TOKEN. See the README's
# "Access tiers" section and docs/runbooks/rotate-mcp-tokens.md.
# MCP_AUTH_TOKEN_LIMITED=

# Optional: comma-separated vault-relative folders the limited tier may write
# under (e.g. Inbox,Claude/Notes). Unset means anywhere the path policy allows.
# MCP_LIMITED_WRITE_DIRS=

# Header a gateway may send with its own request id; a well-formed value is
# recorded on audit lines as upstreamRequestId (correlation only).
# MCP_UPSTREAM_REQUEST_ID_HEADER=x-request-id

# Escape hatch: start on a non-loopback bind without a token. Only the anonymous
# read tools are served, under the same path policy as the limited tier.
# MCP_ALLOW_UNAUTHENTICATED=false

# Optional: obsidi-backup integration (set to enable backup tools)
# BACKUP_URL=http://obsidian-vault-backup:8080

# Optional: obsidi-mcp plugin integration (set to enable plugin proxy tools)
# PLUGIN_MCP_URL=http://obsidian:3000/mcp

# Optional: daily note settings
# DAILY_NOTE_FOLDER=Daily Notes
# DAILY_NOTE_TEMPLATE=Templates/Daily Note.md
