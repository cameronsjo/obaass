# Required: path to the Obsidian vault on disk
VAULT_PATH=/vault

# MCP server settings
MCP_HTTP_PORT=3000
# Loopback by default. Any other bind (0.0.0.0, a LAN or tailnet IP) needs
# MCP_AUTH_TOKEN, or the server refuses to start.
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PATH=/mcp
LOG_LEVEL=info

# Bearer token for the MCP path (/health stays open). Required when
# MCP_HTTP_HOST is not loopback. At least 32 characters: `openssl rand -hex 32`.
# Clients send `Authorization: Bearer <token>`. Keep it out of git.
# MCP_AUTH_TOKEN=

# Escape hatch: start on a non-loopback bind without a token. Only read-only
# tools are served; every write tool stays disabled until MCP_AUTH_TOKEN is set.
# MCP_ALLOW_UNAUTHENTICATED=false

# Optional: obsidi-backup integration (set to enable backup tools)
# BACKUP_URL=http://obsidian-vault-backup:8080

# Optional: obsidi-mcp plugin integration (set to enable plugin proxy tools)
# PLUGIN_MCP_URL=http://obsidian:3000/mcp

# Optional: daily note settings
# DAILY_NOTE_FOLDER=Daily Notes
# DAILY_NOTE_TEMPLATE=Templates/Daily Note.md
