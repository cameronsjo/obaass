# Required
VAULT_PATH=.                        # Directory containing your vault/ folder

# Optional: timezone
TZ=UTC

# Optional: additional MCP Host/Origin endpoints; loopback-only by default.
# Bare names use HTTP at the MCP server's configured port. HTTPS proxies are explicit.
# Example: vault.example.ts.net,100.100.100.100,https://vault.example.ts.net
MCP_ALLOWED_HOSTS=

# Standalone mcp/ service only: bearer token required when it binds beyond
# loopback (`openssl rand -hex 32`). See mcp/.env.example.
# MCP_AUTH_TOKEN=

# Optional: backup tuning
BACKUP_DEBOUNCE=300                 # Seconds to wait after last change before committing
GIT_USER_NAME=Obsidian Backup
GIT_USER_EMAIL=backup@local

# Optional: push commits to a remote git server (e.g., Gitea)
GIT_REMOTE_URL=                     # e.g., git@git.sjo.lol:cameron/the-compendium.git

# Optional: offsite backup (restic)
RESTIC_REPOSITORY=                  # e.g., s3:s3.amazonaws.com/bucket, azure:container:/
RESTIC_PASSWORD=                    # Encryption password for restic repo

# Optional: AI commit messages (requires Anthropic API key)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Optional: Discord notifications on backup
DISCORD_WEBHOOK_URL=
